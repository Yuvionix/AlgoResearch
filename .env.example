# AlgoResearch environment
# Copy to .env and adjust. Never commit .env.

FLASK_ENV=development
# Keep disabled outside local debugging.
FLASK_DEBUG=0
PORT=5001
HOST=127.0.0.1

# Comma-separated allowed origins for the React app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum CSV upload size in megabytes
MAX_UPLOAD_MB=5

# Yahoo Finance request timeout (seconds)
YFINANCE_TIMEOUT=20

# Optional: disable remote fetches during tests
# ALGORESEARCH_OFFLINE=1
